{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENPost",
  "mainBinaryName": "enpost",
  "version": "0.1.0",
  "identifier": "com.mestiaque.enpost",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ENPost",
        "width": 1320,
        "height": 840,
        "minWidth": 860,
        "minHeight": 540,
        "backgroundColor": "#131315",
        "center": true,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "M. Estiaque Ahmed Khan",
    "category": "DeveloperTool",
    "shortDescription": "API development and testing",
    "longDescription": "ENPost is an offline-first desktop app for building, sending and testing API requests.",
    "copyright": "© 2026 M. Estiaque Ahmed Khan · MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "section": "devel" } },
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "homepage": "https://mestiaque.com"
  }
}
